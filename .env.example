# Database
DATABASE_URL=postgresql://petmatch:petmatch123@localhost:5432/petmatch_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2
MIN_IOS_VERSION=1.0.0
MIN_ANDROID_VERSION=1.0.0
LATEST_IOS_VERSION=1.0.0
LATEST_ANDROID_VERSION=1.0.0
FORCE_UPDATE_IOS=false
FORCE_UPDATE_ANDROID=false
APP_STORE_URL=https://apps.apple.com/search?term=PawMatch&entity=software
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.petmatch.petmatch
UPDATE_MESSAGE=Hay una nueva versión de PawMatch. Actualizá la app para seguir usando todas las funciones.

# Brevo (email transaccional)
BREVO_API_KEY=xkeysib-your-brevo-api-key
LANDING_URL=https://pawmatch.com.ar
PUBLIC_WEB_URL=https://pawmatch.com.ar
SMTP_FROM_EMAIL=noreply@pawmatch.com.ar
SMTP_FROM_NAME=PawMatch

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-your-access-token
MERCADO_PAGO_WEBHOOK_SECRET=change-this-shared-secret
MERCADO_PAGO_BACK_URL_SUCCESS=petmatch://patitas/success
MERCADO_PAGO_BACK_URL_FAILURE=petmatch://patitas/failure
MERCADO_PAGO_BACK_URL_PENDING=petmatch://patitas/pending
